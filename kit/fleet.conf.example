# kit/bootstrap-vps.sh configuration. Copy to fleet.conf and edit; every value has a default.
# Directories
FLEET_HOME="$HOME/fleet"                 # holds desk-fleet/ and machines.json
OPT_DIR="$HOME/opt"                      # node24/ and orca/ go here
# Source (git URL or path). Defaults to the checkout this script runs from.
DESK_FLEET_REPO=""
# Runtimes
NODE24_VERSION="v24.22.1"                # desk-gateway
ORCA_VERSION="1.4.271"                   # Orca desktop package, run headless as `orca-ide serve`
ORCA_DEB_SHA256="7fad3d721dc0b0920f248353f5391fe0138331791acb64c9677c7a91bf41e755"   # change together with ORCA_VERSION
# Orca server (tailnet only; clients pair with `orca-ide pair --address <tailnet ip>`)
ORCA_PORT="6768"
ORCA_ADDRESS=""                          # pairing address; default: this VPS's tailnet IPv4
ORCA_MEMORY_HIGH="2200M"                 # Orca plus the Claude sessions opened from it
ORCA_MEMORY_MAX="2800M"
ORCA_TERMINAL_MEMORY_MAX="1200M"         # per Orca terminal
